{
  "name": "pokemon-tcg-deck-parser",
  "version": "0.1.0",
  "description": "Parse Pokémon TCG Live and Limitless deck exports and resolve cards via the TCGdex API.",
  "license": "MIT",
  "author": "",
  "keywords": [
    "pokemon",
    "tcg",
    "ptcgl",
    "limitless",
    "decklist",
    "parser",
    "tcgdex"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@tcgdex/sdk": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  }
}
